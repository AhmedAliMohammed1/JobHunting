# Copy this file to .env.local for local development.
# NEVER put real API keys or secrets in this tracked file.
# To pull the production configuration locally after linking Vercel:
#   vercel env pull .env.local --environment=production --yes

# Runtime
NODE_ENV=development

# Public app and Supabase project values
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Never expose with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# AI: mock is deterministic and local; openai-compatible requires all fields below.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# Job providers. Production automatically uses live mode.
JOB_PROVIDER_MODE=mock
ENABLE_ARBEITNOW=true
ENABLE_REMOTE_OK=true
ENABLE_REMOTIVE=false
REMOTIVE_CACHE_TTL_SECONDS=21600

# Official job APIs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=de,gb,us
JOOBLE_API_KEY=

# Public search discovery for LinkedIn, Indeed, XING, StepStone, Glassdoor,
# ATS postings and public company career pages.
# Tavily is primary and Serper is an independent Google Search fallback.
# All requests run server-side; never expose these keys in client-side variables.
TAVILY_API_KEY=
SERPER_API_KEY=
SEARCH_DISCOVERY_CACHE_TTL_SECONDS=600

# Optional employer-specific ATS registry. JSON array entries:
# {"company":"Example","provider":"greenhouse|lever|ashby|smartrecruiters|personio|workday|successfactors","identifier":"example","careerUrl":"https://..."}
JOB_CAREER_SOURCES_JSON=[]

# Automation. Keep disabled unless the corresponding backend/worker is configured.
FEATURE_AUTO_APPLY=false
FEATURE_BROWSER_AUTOMATION=false
FEATURE_EMAIL_ALERTS=false
AUTOMATION_WORKER_URL=
AUTOMATION_WORKER_SECRET=
CRON_SECRET=
