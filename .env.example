# Public app and Supabase project values
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI: mock is deterministic and local; openai-compatible requires all fields below
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
EMBEDDING_MODEL=text-embedding-3-small

# Job providers. Mock fixtures are never mixed into live results.
JOB_PROVIDER_MODE=mock
ENABLE_ARBEITNOW=true
ENABLE_REMOTE_OK=true
ENABLE_REMOTIVE=false
REMOTIVE_CACHE_TTL_SECONDS=21600

# Optional official job APIs. Missing credentials never break the complete search.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=de,gb,us
JOOBLE_API_KEY=

# Optional public search discovery fallback for LinkedIn, Indeed, StepStone, XING,
# Glassdoor, public ATS postings, Workday/SuccessFactors, and company career pages.
# All requests run server-side. No browser login, cookies, CAPTCHA bypass, or private APIs are used.
TAVILY_API_KEY=
SEARCH_DISCOVERY_CACHE_TTL_SECONDS=600

# Optional employer-specific ATS registry. JSON array entries:
# {"company":"Example","provider":"greenhouse|lever|ashby|smartrecruiters|personio|workday|successfactors","identifier":"example","careerUrl":"https://..."}
JOB_CAREER_SOURCES_JSON=[]

# Automation is off by default and requires simulation plus explicit user enablement.
FEATURE_AUTO_APPLY=false
FEATURE_BROWSER_AUTOMATION=false
FEATURE_EMAIL_ALERTS=false
AUTOMATION_WORKER_URL=
AUTOMATION_WORKER_SECRET=
CRON_SECRET=
