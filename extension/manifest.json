{
  "manifest_version": 3,
  "name": "JobHunter AI Application Assistant",
  "version": "0.1.0",
  "description": "Reviews and fills approved application fields while keeping submission under user control.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["https://*/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
